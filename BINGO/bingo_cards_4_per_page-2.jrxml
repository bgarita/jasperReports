	<query language="SQL"><![CDATA[SELECT
    c.id AS cardId,
    LPAD(c.id, 5, '0') AS cardCode,

    c.b1, c.b2, c.b3, c.b4, c.b5,
    c.i1, c.i2, c.i3, c.i4, c.i5,
    c.n1, c.n2, c.n3, c.n4, c.n5,
    c.g1, c.g2, c.g3, c.g4, c.g5,
    c.o1, c.o2, c.o3, c.o4, c.o5

FROM $P!{TABLE_NAME} C
WHERE $P!{WHERE}
ORDER BY c.id
]]></query>
