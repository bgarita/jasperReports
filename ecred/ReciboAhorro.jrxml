<jasperReport name="Recibo" language="java" pageWidth="591" pageHeight="612" columnWidth="571" leftMargin="10" rightMargin="10" topMargin="20" bottomMargin="20" uuid="ea336f77-abc2-4ed9-9d6c-7fb39f8ef316">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ECRED"/>
	<property name="com.jaspersoft.studio.report.description" value=""/>
	<parameter name="p_id" class="java.lang.Integer">
		<description><![CDATA[ID en la tabla ahorros_movimiento]]></description>
		<defaultValueExpression><![CDATA[953]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT 
	(Select company_name from config limit 1) as company_name,
	banco.descrip AS banco,
	td.descrip AS tipo_doc,
	a.ref AS referencia_banco,
	a.id,
	a.documento,
	a.cliente_id ,
	concat(c.nombre, ' ', c.apellido1, ' ', c.apellido2) AS cliente,
	a.producto_id,
	p.descrip,
	a.fecha,
	FUN_ahorro_saldo_anterior(a.id) AS saldo_anterior,
	if(a.tipo_mov=0,Round(a.monto,2),Round(a.monto,2)*-1)  AS monto,
	FUN_ahorro_saldo_anterior(a.id) + if(a.tipo_mov=0,Round(a.monto,2),Round(a.monto,2)*-1) AS saldo,
	p.tasa,
	if(a.tipo_mov = 0, 'Crédito', 'Débito') AS tipo,
	if(a.tipo_monto = 0, 'Regular', 'Interés') AS tipo_monto
FROM ahorros_movimiento a
INNER JOIN cliente c ON a.cliente_id = c.id
INNER JOIN producto p ON a.producto_id = p.id
INNER JOIN banco ON a.banco_id = banco.id
INNER JOIN tipos_documento td ON a.tipo_doc = td.id
WHERE a.id = $P{p_id};]]></query>
